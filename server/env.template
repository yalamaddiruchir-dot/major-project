# ============================================================================
# Digital Learning Platform for Rural Schools - Server Configuration Template
# Copy to server/.env and replace placeholders before running. Never commit .env!
# ============================================================================

PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000

# Reverse-proxy & HTTPS enforcement (enable in production behind Nginx/Caddy/Cloudflare)
TRUST_PROXY=false
FORCE_HTTPS=false
SERVE_CLIENT=false

# REQUIRED: Cryptographic JWT secret (at least 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional custom paths (defaults shown below)
# DB_PATH=./database/digital_learning.sqlite
# BACKUP_DIR=./backups
# LOG_DIR=./logs

# Rate limiting thresholds (per window)
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_UPLOAD_MAX=40
RATE_LIMIT_API_MAX=300

# Institution branding for certificates
SCHOOL_NAME=Rural Digital Learning Institution

# One-time first administrator bootstrap (npm run create-admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@school.local
ADMIN_FULL_NAME=Platform Administrator
ADMIN_PASSWORD=

# Optional destructive reset-and-seed passwords (ONLY used with CONFIRM_RESET=YES npm run seed:reset)
# SEED_ADMIN_PASSWORD=
# SEED_TEACHER_PASSWORD=
# SEED_STUDENT_PASSWORD=
