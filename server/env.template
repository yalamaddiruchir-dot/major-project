# Copy this file to server/.env and replace the secret before deployment.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: defaults to server/database/digital_learning.sqlite
# DB_PATH=./database/digital_learning.sqlite

# One-time first administrator bootstrap (npm run create-admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@school.local
ADMIN_FULL_NAME=Platform Administrator
ADMIN_PASSWORD=
SCHOOL_NAME=Rural School

# Optional: bootstrap sample users during migration
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@school.local
# BOOTSTRAP_ADMIN_NAME=Platform Administrator
# BOOTSTRAP_ADMIN_PASSWORD=unique-password-at-least-12-characters
# BOOTSTRAP_TEACHER_USERNAME=teacher1
# BOOTSTRAP_TEACHER_EMAIL=teacher@school.local
# BOOTSTRAP_TEACHER_NAME=Demo Teacher
# BOOTSTRAP_TEACHER_PASSWORD=another-unique-password-at-least-12-characters

# Required only for destructive demo seeding (each at least 12 characters)
# SEED_ADMIN_PASSWORD=unique-admin-demo-password
# SEED_TEACHER_PASSWORD=unique-teacher-demo-password
